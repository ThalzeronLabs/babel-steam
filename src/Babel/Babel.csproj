<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\babel.ico</ApplicationIcon>
    <AssemblyName>Babel</AssemblyName>
    <RootNamespace>Babel</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Babel para Steam</Product>
    <Company>Thalzeron Labs</Company>
    <Authors>Esdras Souza</Authors>
    <Copyright>© 2026 Esdras Souza (Thalzeron Labs)</Copyright>
    <Description>Traduz para o português do Brasil o que as pessoas e os estúdios escrevem na Steam, com a sua chave grátis do Gemini.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <!-- WPF draws the windows and reads its DPI awareness from app.manifest; WinForms only hosts the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- The SQLite engine that Microsoft.Data.Sqlite brings is pinned to a version without GHSA-2m69-gcr7-jv3q
         (it affects 2.1.11 and older). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\pagina.js" LogicalName="Babel.pagina.js" />
    <EmbeddedResource Include="Web\glossario.txt" LogicalName="Babel.glossario.txt" />
    <Resource Include="Assets\babel.ico" />
    <InternalsVisibleTo Include="Babel.Tests" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
